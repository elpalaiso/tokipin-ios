            "value" : "Google verileri nasıl işler?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách Google xử lý dữ liệu"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
