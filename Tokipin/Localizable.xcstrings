    },
    "Stepzu가 보유한 개인정보의 열람·정정·삭제나 처리정지를 원하시면 아래 개인정보 문의 창구로 연락해 주세요. 기기에만 있는 기록은 앱에서 직접 확인하고 수정하거나 지울 수 있어요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Auskunft über deine bei Stepzu gespeicherten personenbezogenen Daten erhalten, sie berichtigen oder löschen lassen oder ihre weitere Verarbeitung stoppen möchtest, schreibe an die unten genannte Datenschutzadresse. Notizen, die nur auf deinem Gerät gespeichert sind, kannst du in der App ansehen, bearbeiten und löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To request access to, correction or deletion of personal information held by Stepzu, or to ask us to stop processing it, email our privacy contact below. You can view, edit and delete records stored only on your device in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para solicitar el acceso a tus datos personales en poder de Stepzu, su rectificación o supresión, o para pedir que dejemos de tratarlos, escribe a la dirección que figura a continuación. Puedes consultar, editar y borrar en la app las notas que solo se guardan en tu dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para solicitar el acceso a tus datos personales en poder de Stepzu, su rectificación o supresión, o para pedir que dejemos de tratarlos, escribe a la dirección que figura a continuación. Puedes consultar, editar y borrar en la app las notas que solo se guardan en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour demander l’accès à vos données personnelles détenues par Stepzu, leur rectification, leur suppression ou l’arrêt de leur traitement, écrivez à l’adresse indiquée ci-dessous. Les notes conservées uniquement sur votre appareil peuvent être consultées, modifiées et supprimées dans l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stepzu के पास मौजूद अपनी निजी जानकारी देखने, उसमें सुधार कराने, उसे मिटाने या उसका इस्तेमाल रोकने का अनुरोध करने के लिए नीचे दिए गए गोपनीयता संपर्क पते पर ईमेल करें। सिर्फ़ आपके डिवाइस पर सहेजी गई प्रविष्टियाँ आप ऐप में देख, बदल और मिटा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk meminta akses, perbaikan, penghapusan, atau penghentian pemrosesan informasi pribadi yang disimpan Stepzu, hubungi kami melalui alamat email privasi di bawah ini. Catatan yang hanya tersimpan di perangkat dapat Anda lihat, ubah, dan hapus langsung di aplikasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stepzuが保有する個人情報の開示・訂正・削除、または利用停止をご希望の場合は、下記のプライバシー窓口にメールでご連絡ください。端末にのみ保存されている記録は、アプリで直接確認・編集・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stepzu가 보유한 개인정보의 열람·정정·삭제나 처리정지를 원하시면 아래 개인정보 문의 창구로 연락해 주세요. 기기에만 있는 기록은 앱에서 직접 확인하고 수정하거나 지울 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para pedir acesso, correção ou exclusão dos seus dados pessoais mantidos pela Stepzu, ou solicitar que deixemos de tratá-los, escreva para o endereço de contato abaixo. Você pode consultar, editar e excluir no app as anotações armazenadas apenas no seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы получить доступ к персональным данным, которыми располагает Stepzu, запросить их исправление или удаление либо прекращение обработки, напишите по указанному ниже адресу. Записи, которые хранятся только на вашем устройстве, можно просматривать, изменять и удалять в самом приложении."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการขอเข้าถึง แก้ไข หรือลบข้อมูลส่วนบุคคลที่ Stepzu เก็บไว้ หรือขอให้หยุดประมวลผล โปรดติดต่อทางอีเมลสำหรับเรื่องความเป็นส่วนตัวด้านล่าง สำหรับบันทึกที่เก็บไว้เฉพาะในอุปกรณ์ คุณสามารถดู แก้ไข หรือลบได้ในแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stepzu’nun elinde bulunan kişisel verilerinize erişmek, bunların düzeltilmesini, silinmesini veya işlenmesinin durdurulmasını istemek için aşağıdaki gizlilik iletişim adresine yazabilirsiniz. Yalnızca cihazınızda saklanan notları uygulama içinde görüntüleyebilir, düzenleyebilir ve silebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để yêu cầu truy cập, chỉnh sửa hoặc xóa thông tin cá nhân mà Stepzu lưu giữ, hoặc yêu cầu ngừng xử lý, vui lòng gửi email đến địa chỉ liên hệ về quyền riêng tư bên dưới. Với các mục nhật ký chỉ được lưu trên thiết bị, bạn có thể xem, chỉnh sửa và xóa ngay trong ứng dụng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要查閱、更正或刪除 Stepzu 持有的個人資料，或要求我們停止處理，請透過下方的私隱聯絡電郵與我們聯絡。只儲存在自己裝置上的記錄，可以直接在應用程式中查看、修改及刪除。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需查阅、更正或删除 Stepzu 持有的个人信息，或要求停止处理，请通过下方的隐私联系邮箱与我们联系。对于仅保存在自己设备上的记录，你可以直接在应用中查看、修改和删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需查閱、更正或刪除 Stepzu 持有的個人資料，或要求停止處理，請寄信至下方的隱私聯絡信箱。只儲存在自己裝置上的紀錄，可以直接在 App 中查看、修改和刪除。"
          }
        }
      }
    },
