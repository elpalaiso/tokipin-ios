    "앱 이용이나 약관에 관해 궁금한 점은 Stepzu에 메일로 보내 주세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe Stepzu eine E-Mail, wenn du Fragen zur Nutzung von Tokipin oder zu diesen Bedingungen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email Stepzu if you have a question about using Tokipin or about these terms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes alguna pregunta sobre el uso de Tokipin o sobre estas condiciones, escribe a Stepzu por correo electrónico."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes alguna pregunta sobre el uso de Tokipin o sobre estas condiciones, escribe a Stepzu por correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez à Stepzu si vous avez une question sur l’utilisation de Tokipin ou sur ces conditions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin का इस्तेमाल करने या इन शर्तों के बारे में कोई सवाल हो, तो Stepzu को ईमेल भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
