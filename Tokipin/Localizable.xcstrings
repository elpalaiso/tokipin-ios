    "쓰면서 떠오른 생각이 있나요?\n어떤 이야기든 반가워요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist dir beim Schreiben etwas eingefallen?\nWir freuen uns über jede Nachricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thought of something while writing?\nWe’d love to hear anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se te ha ocurrido algo mientras escribías?\nNos encantará leerte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se te ocurrió algo mientras escribías?\nNos encantará leerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une idée vous est venue en écrivant ?\nNous serons ravis de vous lire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिखते समय कोई विचार आया?\nहम कुछ भी सुनना चाहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada yang terpikir saat menulis?\nCerita apa pun kami sambut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録しながら思いついたことはありますか？\nどんなことでも大歓迎です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰면서 떠오른 생각이 있나요?\n어떤 이야기든 반가워요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensou em algo enquanto escrevia?\nQueremos ouvir o que for."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Появилась мысль, пока писали?\nБудем рады любому сообщению."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีความคิดอะไรเกิดขึ้นระหว่างเขียนไหม\nเรายินดีรับฟังทุกเรื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazarken aklına bir şey geldi mi?\nHer türlü mesaja açığız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có suy nghĩ gì khi ghi chép không?\nChúng tôi luôn vui khi được nghe."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫的時候有想到甚麼嗎？\n任何想法都歡迎告訴我們。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写的时候有想到什么吗？\n什么都欢迎告诉我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫的時候有想到什麼嗎？\n任何想法都歡迎告訴我們。"
          }
        }
      }
    },
