    "앱 사용 통계 공유" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Nutzungsstatistiken teilen"
          }
        },
        "en" : {
          "stringUnit" : {
