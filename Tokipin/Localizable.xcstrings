        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월을 누르거나 두 손가락을 벌려 한 달을 펼치세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um mês ou afaste dois dedos na tela para vê-lo de perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на месяц или разведите два пальца, чтобы открыть его."
