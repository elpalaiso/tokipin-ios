    },
    "Tokipin은 계정으로 기록을 동기화하지 않아요. 기기를 바꾸거나 앱 데이터를 지우기 전에 보관하고 싶은 기록은 설정에서 JSON 파일로 내보내 주세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin synchronisiert Notizen nicht über ein Konto. Exportiere Notizen, die du behalten möchtest, vor einem Gerätewechsel oder dem Löschen der App-Daten in den Einstellungen als JSON-Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin doesn’t sync notes through an account. Before changing devices or clearing the app’s data, export the notes you want to keep as a JSON file in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin no sincroniza las notas mediante una cuenta. Antes de cambiar de dispositivo o borrar los datos de la app, exporta desde los ajustes las notas que quieras conservar a un archivo JSON."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin no sincroniza las notas mediante una cuenta. Antes de cambiar de dispositivo o borrar los datos de la app, exporta desde la configuración las notas que quieras conservar a un archivo JSON."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin ne synchronise pas les notes via un compte. Avant de changer d’appareil ou d’effacer les données de l’application, exportez depuis les réglages les notes à conserver dans un fichier JSON."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin खाते के ज़रिए नोट सिंक नहीं करता। डिवाइस बदलने या ऐप का डेटा साफ़ करने से पहले, जो नोट रखना चाहते हैं उन्हें सेटिंग्स से JSON फ़ाइल में एक्सपोर्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin tidak menyinkronkan catatan melalui akun. Sebelum mengganti perangkat atau menghapus data aplikasi, ekspor catatan yang ingin disimpan sebagai file JSON di pengaturan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin はアカウント経由で記録を同期しません。機種変更やアプリデータの消去の前に、残したい記録を設定から JSON ファイルに書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin은 계정으로 기록을 동기화하지 않아요. 기기를 바꾸거나 앱 데이터를 지우기 전에 보관하고 싶은 기록은 설정에서 JSON 파일로 내보내 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tokipin não sincroniza suas anotações por meio de uma conta. Antes de trocar de dispositivo ou limpar os dados do app, abra as configurações e exporte para um arquivo JSON as anotações que quiser guardar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin не синхронизирует записи через учётную запись. Перед сменой устройства или очисткой данных приложения экспортируйте нужные записи в файл JSON через настройки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin ไม่ซิงค์บันทึกผ่านบัญชี ก่อนเปลี่ยนอุปกรณ์หรือล้างข้อมูลแอป โปรดไปที่การตั้งค่าเพื่อส่งออกบันทึกที่ต้องการเก็บไว้เป็นไฟล์ JSON"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin notlarını bir hesap aracılığıyla eşitlemez. Cihazını değiştirmeden veya uygulama verilerini temizlemeden önce, saklamak istediğin notları ayarlardan JSON dosyası olarak dışa aktar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin không đồng bộ ghi chú qua tài khoản. Trước khi đổi thiết bị hoặc xóa dữ liệu ứng dụng, hãy xuất những ghi chú muốn giữ thành tệp JSON trong phần cài đặt."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin 不會透過帳戶同步記錄。更換裝置或清除應用程式資料前，請先在設定中將想保留的記錄匯出為 JSON 檔案。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin 不通过账号同步记录。更换设备或清除应用数据前，请先在设置中将希望保留的记录导出为 JSON 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin 不會透過帳號同步紀錄。更換裝置或清除 App 資料前，請先在設定中將想保留的紀錄匯出成 JSON 檔案。"
          }
        }
      }
    },
    "Tokipin은 회원가입 없이 사용하는 iOS·Android 기록 앱이에요. 기록과 작성 중인 초안은 기기의 앱 저장공간에 보관해요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin ist eine Notiz-App für iOS und Android. Du kannst sie ohne Konto nutzen. Deine Notizen und Entwürfe liegen im Speicher der App auf deinem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin is a journal for iOS and Android. You can use it without an account. The app keeps your notes and drafts in its storage on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin es una app de notas para iOS y Android. Puedes usarla sin registrarte. La app guarda tus notas y borradores en tu dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin es una app de notas para iOS y Android. Puedes usarla sin registrarte. La app guarda tus notas y borradores en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin est une application de prise de notes pour iOS et Android. Vous pouvez l’utiliser sans créer de compte. Vos notes et vos brouillons restent dans l’espace de stockage de l’application sur votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin, iOS और Android के लिए एक नोट ऐप है जिसे बिना खाता बनाए इस्तेमाल किया जा सकता है। आपके नोट और अधूरे ड्राफ़्ट आपके डिवाइस पर ऐप के स्टोरेज में सहेजे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin adalah aplikasi catatan untuk iOS dan Android yang dapat digunakan tanpa mendaftar. Catatan dan draf yang sedang kamu tulis tersimpan di ruang penyimpanan aplikasi pada perangkatmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipinは、会員登録なしで使えるiOS・Android向けの記録アプリです。記録や書きかけの下書きは、お使いの端末のアプリ専用領域に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin은 회원가입 없이 사용하는 iOS·Android 기록 앱이에요. 기록과 작성 중인 초안은 기기의 앱 저장공간에 보관해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tokipin é um app de anotações para iOS e Android. Você pode usá-lo sem criar uma conta. Suas anotações e seus rascunhos ficam armazenados no app, no seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin — приложение для личных записей на iOS и Android. Им можно пользоваться без регистрации. Ваши записи и черновики хранятся в памяти приложения на устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin เป็นแอปจดบันทึกสำหรับ iOS และ Android ที่ใช้งานได้โดยไม่ต้องสมัครสมาชิก บันทึกและฉบับร่างที่เขียนค้างไว้จะเก็บอยู่ในพื้นที่จัดเก็บของแอปบนอุปกรณ์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin, iOS ve Android’de hesap açmadan kullanabileceğin bir not uygulaması. Notların ve üzerinde çalıştığın taslaklar cihazında, uygulamanın kendi alanında saklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin là ứng dụng ghi chú cho iOS và Android, không cần đăng ký. Ghi chú và bản nháp của bạn được lưu trong bộ nhớ dành riêng cho ứng dụng trên thiết bị."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin 是一款毋須註冊即可使用的 iOS 及 Android 記錄應用程式。記錄和草稿均儲存在裝置上此應用程式的專用空間。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin 是一款无需注册的 iOS 和 Android 记录应用。记录和草稿都保存在设备上这款应用的存储空间内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin 是一款不必註冊就能使用的 iOS 與 Android 紀錄 App。紀錄與草稿都儲存在裝置上這個 App 的專用空間。"
          }
        }
      }
    },
