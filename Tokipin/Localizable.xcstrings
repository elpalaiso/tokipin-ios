    "이 약관은 대한민국의 Stepzu가 제공하는 Tokipin iOS·Android 앱과 웹 체험에 적용돼요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Bedingungen gelten für die Tokipin-Apps für iOS und Android sowie für die Web-Demo von Stepzu mit Sitz in der Republik Korea."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These terms apply to the Tokipin iOS and Android apps and the web demo provided by Stepzu, based in the Republic of Korea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas condiciones se aplican a las apps de Tokipin para iOS y Android y a la demo web que ofrece Stepzu, con sede en la República de Corea."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas condiciones se aplican a las apps de Tokipin para iOS y Android y a la demo web que ofrece Stepzu, con sede en la República de Corea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces conditions s’appliquent aux apps Tokipin pour iOS et Android et à la démo web proposées par Stepzu, établi en République de Corée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये शर्तें कोरिया गणराज्य में स्थित Stepzu द्वारा उपलब्ध कराए गए Tokipin के iOS और Android ऐप और वेब डेमो पर लागू होती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketentuan ini berlaku untuk aplikasi Tokipin di iOS dan Android serta demo web yang disediakan oleh Stepzu, yang berkedudukan di Republik Korea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本規約は、韓国のStepzuが提供するTokipinのiOS・Androidアプリおよびウェブ体験版に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 약관은 대한민국의 Stepzu가 제공하는 Tokipin iOS·Android 앱과 웹 체험에 적용돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes termos se aplicam aos apps Tokipin para iOS e Android e à demonstração na web oferecidos pela Stepzu, com sede na República da Coreia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти условия распространяются на приложения Tokipin для iOS и Android и на веб-демоверсию, предоставляемые Stepzu (Республика Корея)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อกำหนดนี้ใช้กับแอป Tokipin สำหรับ iOS และ Android รวมถึงเว็บทดลองใช้ที่ให้บริการโดย Stepzu ซึ่งตั้งอยู่ในสาธารณรัฐเกาหลี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu koşullar, Kore Cumhuriyeti merkezli Stepzu’nun sunduğu iOS ve Android için Tokipin uygulamaları ile web demosu için geçerlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các điều khoản này áp dụng cho ứng dụng Tokipin trên iOS và Android cùng bản trải nghiệm trên web do Stepzu, có trụ sở tại Hàn Quốc, cung cấp."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本條款適用於位於韓國的 Stepzu 提供的 Tokipin iOS 和 Android 應用程式及網頁體驗版。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本条款适用于位于韩国的 Stepzu 提供的 Tokipin iOS 和 Android 应用及网页版体验。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本條款適用於位於韓國的 Stepzu 提供的 Tokipin iOS 和 Android App，以及網頁體驗版。"
          }
        }
      }
    },
