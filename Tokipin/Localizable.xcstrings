    "위의 월 숫자를 누르거나 좌우로 밀어 다른 달을 보세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben auf einen Monat oder wische nach links oder rechts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a month above or swipe left or right to switch months."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca uno de los meses de arriba o desliza el dedo hacia un lado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca uno de los meses de arriba o desliza el dedo hacia un lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un mois en haut ou balayez sur le côté pour changer de mois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महीना बदलने के लिए ऊपर उसका नंबर टैप करें या दाएँ-बाएँ स्वाइप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk bulan di atas atau usap ke samping untuk berpindah bulan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上の月をタップするか、左右にスワイプして月を切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 월 숫자를 누르거나 좌우로 밀어 다른 달을 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mudar de mês, toque em um dos meses acima ou deslize para o lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на месяц вверху или смахните в сторону, чтобы сменить месяц."
