    "기기에 저장된 기록을 읽을 수 없어요.\n잠시 후 다시 시도해 주세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die auf diesem Gerät gespeicherten Notizen können nicht gelesen werden.\nVersuche es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The notes saved on this device can’t be read.\nPlease try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden leer las notas guardadas en este dispositivo.\nVuelve a intentarlo dentro de un momento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden leer las notas guardadas en este dispositivo.\nVuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les notes enregistrées sur cet appareil.\nRéessayez dans un instant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर सहेजे गए नोट पढ़े नहीं जा सके।\nकुछ देर बाद फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan yang tersimpan di perangkat ini tidak dapat dibaca.\nCoba lagi sebentar lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末に保存された記録を読み込めません。\nしばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에 저장된 기록을 읽을 수 없어요.\n잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as anotações salvas neste dispositivo.\nTente de novo daqui a pouco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся прочитать записи на этом устройстве.\nПопробуйте ещё раз чуть позже."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านบันทึกที่เก็บไว้ในอุปกรณ์นี้ไม่ได้\nโปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda kayıtlı notlar okunamıyor.\nBiraz sonra tekrar dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đọc được ghi chú đã lưu trên thiết bị này.\nVui lòng thử lại sau giây lát."
          }
        },
        "zh-HK" : {
