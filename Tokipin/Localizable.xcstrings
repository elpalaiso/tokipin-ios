          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากมีคำถามเกี่ยวกับการใช้ Tokipin หรือข้อกำหนดนี้ โปรดส่งอีเมลถึง Stepzu"
