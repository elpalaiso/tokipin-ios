    "월을 누르거나 두 손가락을 벌려 한 달을 펼치세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Monat oder spreize zwei Finger, um ihn zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a month or spread two fingers apart to open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un mes o separa dos dedos sobre la pantalla para verlo en detalle."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un mes o separa dos dedos sobre la pantalla para verlo en detalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un mois ou écartez deux doigts pour l’ouvrir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महीना खोलने के लिए उस पर टैप करें या दो उँगलियाँ फैलाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk bulan atau renggangkan dua jari untuk membukanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月をタップするか、2本の指を広げると月間カレンダーが開きます。"
