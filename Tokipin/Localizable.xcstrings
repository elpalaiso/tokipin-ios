    "쓰면서 떠오른 생각이 있나요?\n어떤 이야기든 반가워요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist dir beim Schreiben etwas eingefallen?\nWir freuen uns über jede Nachricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thought of something while writing?\nWe’d love to hear anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se te ha ocurrido algo mientras escribías?\nNos encantará leerte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se te ocurrió algo mientras escribías?\nNos encantará leerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une idée vous est venue en écrivant ?\nNous serons ravis de vous lire."
