    "Does Tokipin access my location or calendar?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greift Tokipin auf meinen Standort oder Kalender zu?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does Tokipin access my location or calendar?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Accede Tokipin a mi ubicación o calendario?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
