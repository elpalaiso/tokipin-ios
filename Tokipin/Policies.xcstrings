          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये शर्तें कोरिया गणराज्य में स्थित Stepzu द्वारा उपलब्ध कराए गए Tokipin के iOS और Android ऐप और वेब डेमो पर लागू होती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
