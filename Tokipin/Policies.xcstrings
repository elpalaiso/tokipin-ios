        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin konumuma veya takvimime erişir mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokipin có truy cập vị trí hay lịch của tôi không?"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
